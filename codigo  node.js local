const express = require('express');
const mysql = require('mysql2');
const app = express();

app.use(express.json());

// Conexão com o MySQL
const db = mysql.createPool({
  host: 'localhost',
  user: 'root',
  password: 'SENHA DO MYSQL', 
  database: 'alchemical_db',
  connectionLimit: 20
});

//  Login
app.post('/api/login', (req, res) => {
  const { email, senha } = req.body;
  db.query('SELECT * FROM Conta WHERE email = ? AND senha = ?', [email, senha], (err, results) => {
    if (err) return res.status(500).json({ erro: err.message });
    if (results.length > 0) {
      res.status(200).json({ mensagem: "Login efetuado com sucesso!" });
    } else {
      res.status(401).json({ mensagem: "Credenciais invalidas" });
    }
  });
});

//  Progresso
app.post('/api/progresso', (req, res) => {
  res.status(201).json({ mensagem: "Progresso salvo com sucesso localmente!" });
});

//  Registro
app.post('/api/register', (req, res) => {
  res.status(201).json({ mensagem: "Registro efetuado com sucesso localmente!" });
});

app.listen(3000, () => {
  console.log("==================================================");
  console.log(" SERVIDOR DO ALCHEMICAL RODANDO EM LOCALHOST:3000");
  console.log("==================================================");
});
